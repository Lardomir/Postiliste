# Copy to .env. Never commit real passwords/secrets.
PORT=3000
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_12_PLUS_CHARACTER_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.test
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
SMTP4DEV_WEB_PORT=8025
MAIL_FROM=postiliste@example.test

